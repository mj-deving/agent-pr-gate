@@ -0,0 +1 @@
+Recreate an environment when its ``.tox-info.json`` contains a non-mapping value for a section that requires a mapping.
diff --git a/src/tox/tox_env/info.py b/src/tox/tox_env/info.py
index 600fcef04..3d01f5ec8 100644
--- a/src/tox/tox_env/info.py
+++ b/src/tox/tox_env/info.py
@@ -52,8 +52,9 @@ def compare(
         """
         old = self._content.get(section)
         if sub_section is not None:
-            # a non-dict section is corruption: treat it as absent so it gets replaced below
             old = old.get(sub_section) if isinstance(old, dict) else None
+        if isinstance(value, dict) and not isinstance(old, dict):
+            old = None
 
         if old == value:
             yield True, old
@@ -80,4 +81,6 @@ def _write(self) -> None:
         self._path.write_text(json.dumps(self._content, indent=2))
 
 
-__all__ = ("Info",)
+__all__ = [
+    "Info",
+]
diff --git a/tests/tox_env/test_info.py b/tests/tox_env/test_info.py
index 5f2ac21b0..662b627e8 100644
--- a/tests/tox_env/test_info.py
+++ b/tests/tox_env/test_info.py
@@ -38,3 +38,36 @@ def test_info_non_dict_section_self_heals(tmp_path: Path) -> None:
         assert (eq, old) == (False, None)
 
-    assert json.loads((tmp_path / ".tox-info.json").read_text()) == {"PythonRun": {"deps": ["six"]}}
+
+
+@pytest.mark.parametrize(
+    ("content", "section", "sub_section", "expected"),
+    [
+        pytest.param(
+            '{"Python": []}',
+            "Python",
+            None,
+            {"Python": {"base_python": ["3.14"]}},
+            id="whole section",
+        ),
+        pytest.param(
+            '{"PythonRun": {"deps": []}}',
+            "PythonRun",
+            "deps",
+            {"PythonRun": {"deps": {"base_python": ["3.14"]}}},
+            id="nested section",
+        ),
+    ],
+)
+def test_info_non_dict_mapping_section_self_heals(
+    tmp_path: Path,
+    content: str,
+    section: str,
+    sub_section: str | None,
+    expected: dict[str, dict[str, list[str] | dict[str, list[str]]]],
+) -> None:
+    (tmp_path / ".tox-info.json").write_text(content)
+
+    with Info(tmp_path).compare({"base_python": ["3.14"]}, section, sub_section) as (eq, old):
+        assert (eq, old) == (False, None)
+
+    assert json.loads((tmp_path / ".tox-info.json").read_text()) == expected
