diff --git a/playground/ssr-css/entry-server.js b/playground/ssr-css/entry-server.js
new file mode 100644
index 00000000000000..a367ce1b055792
--- /dev/null
+++ b/playground/ssr-css/entry-server.js
@@ -0,0 +1,15 @@
+import style from './index.css?inline'
+import template from './index.html?raw'
+import lessStyle from './index.less?inline'
+import sassStyle from './index.scss?inline'
+
+export default function render(req, res, next) {
+  if (req.url !== '/') return next()
+
+  const html = template.replace(
+    '<!--head-->',
+    `<style>${style}${sassStyle}${lessStyle}</style>`,
+  )
+  res.setHeader('Content-Type', 'text/html')
+  res.end(html)
+}
