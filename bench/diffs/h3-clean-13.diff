diff --git a/playground/ssr-css/vite.config.js b/playground/ssr-css/vite.config.js
new file mode 100644
index 00000000000000..7b1b9cfd9ab35b
--- /dev/null
+++ b/playground/ssr-css/vite.config.js
@@ -0,0 +1,39 @@
+import path from 'node:path'
+import { defineConfig } from 'vite'
+
+export default defineConfig({
+  appType: 'custom',
+  plugins: [
+    {
+      name: 'ssr-middleware',
+      configureServer(server) {
+        server.middlewares.use(async (req, res, next) => {
+          try {
+            const { default: render } =
+              await server.ssrLoadModule('/entry-server.js')
+            render(req, res, next)
+          } catch (error) {
+            next(error)
+          }
+        })
+      },
+      async configurePreviewServer(server) {
+        const { default: render } = await import(
+          new URL('./dist/ssr/entry-server.js', import.meta.url).href
+        )
+        server.middlewares.use(render)
+      },
+    },
+  ],
+  builder: {},
+  environments: {
+    ssr: {
+      build: {
+        outDir: 'dist/ssr',
+        rolldownOptions: {
+          input: path.join(import.meta.dirname, 'entry-server.js'),
+        },
+      },
+    },
+  },
+})
