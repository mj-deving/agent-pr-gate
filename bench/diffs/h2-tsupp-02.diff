@@ -1561,7 +1565,10 @@ class Http2ClientRequest extends Writable {
 			});
 
 			stream.once('end', () => {
-				if (!this.aborted) {
+				// A reset also ends the stream. An EOF that comes with an error code, including the
+				// `CANCEL` of a request teardown, cut the body short, and an aborted response stays
+				// aborted.
+				if (!response.aborted && (stream.rstCode ?? NGHTTP2_NO_ERROR) === NGHTTP2_NO_ERROR) {
 					response.complete = true;
 					response.push(null);
 				}
@@ -1600,7 +1607,11 @@ class Http2ClientRequest extends Writable {
 
 		stream.once('close', () => {
 			if (this.res) {
-				if (this.aborted) {
+				if (this.aborted || (!this.res.aborted && !streamErrorSeen && !this.res.complete && !this.res.readableEnded)) {
+					// `abort()` and a self-initiated `destroy()` cancel the stream without an
+					// `aborted` event, so complete the response the way a premature close would.
+					// A peer reset already completed it through the stream's `aborted` event, and
+					// a stream error propagates through the request error.
 					this.res.aborted = true;
 					this.res.emit('aborted');
 					this.res.destroy();
diff --git a/test/https.ts b/test/https.ts
index 28359c16a..e780333fb 100644
--- a/test/https.ts
+++ b/test/https.ts
@@ -4859,3 +4859,47 @@ test('http2 stream counts stay balanced for a session without a reservation', as
 		assert.strictEqual(session.reservedStreamCount, 0, `after request ${index + 1}`);
 	}
 });
+
+// `request.destroy()` from the documented `request` event tip cancels the h2 stream without
+// an `aborted` event, so the response must be completed as aborted instead of hanging.
+test('destroying an in-progress http2 request from the request event does not hang', async t => {
+	const server = await createHttp2TestServer(stream => {
+		stream.respond({
+
+			':status': 200,
+		});
+		stream.write('partial');
+	});
+	t.after(async () => {
+		await server.close();
+	});
+
+	const stream = got.stream(server.url, {
+		http2: true,
+		https: {
+			rejectUnauthorized: false,
+		},
+		retry: {
+			limit: 0,
+		},
+	});
+	// @ts-ignore
+	stream.on('request', request => {
+		setTimeout(() => {
+			request.destroy();
+		}, 20);
+	});
+
+	const error = await new Promise<any>((resolve, reject) => {
+		stream.once('error', resolve);
+		stream.once('end', () => {
+			reject(new Error('The stream ended without an error'));
+		});
+		setTimeout(() => {
+			reject(new Error('The request did not settle after being destroyed'));
+		}, 2000);
+	});
+
+	assert.strictEqual(error.name, 'ReadError');
+	assert.strictEqual(error.code, 'ECONNRESET');
+});
