diff --git a/tests/data/cases/preview_walrus_in_subscript_py310.py b/tests/data/cases/preview_walrus_in_subscript_py310.py
new file mode 100644
index 00000000000..061a023f12a
--- /dev/null
+++ b/tests/data/cases/preview_walrus_in_subscript_py310.py
@@ -0,0 +1,23 @@
+# flags: --preview --target-version=py310
+# Since Python 3.10, the parentheses around a named expression in a subscript
+# can be removed.
+x[(y := 1)]
+x[((y := 1))]
+x[(y := 1)] = z
+x[(1)]
+
+
+def lookup(keys, values, key):
+    return values[(i := bisect_left(keys, key))], i
+
+# output
+# Since Python 3.10, the parentheses around a named expression in a subscript
+# can be removed.
+x[y := 1]
+x[y := 1]
+x[y := 1] = z
+x[1]
+
+
+def lookup(keys, values, key):
+    return values[i := bisect_left(keys, key)], i
diff --git a/tests/data/cases/preview_walrus_in_subscript_py38.py b/tests/data/cases/preview_walrus_in_subscript_py38.py
new file mode 100644
index 00000000000..0d0caa72591
--- /dev/null
+++ b/tests/data/cases/preview_walrus_in_subscript_py38.py
@@ -0,0 +1,27 @@
+# flags: --preview --target-version=py38
+# Python 3.9 and older need the parentheses around a named expression in a
+# subscript.
+x[(y := 1)]
+x[((y := 1))]
+x[(  # comment
+    y := 1
+)]
+x[(y := 1)] = z
+x[(1)]
+
+
+def lookup(keys, values, key):
+    return values[(i := bisect_left(keys, key))], i
+
+# output
+# Python 3.9 and older need the parentheses around a named expression in a
+# subscript.
+x[(y := 1)]
+x[(y := 1)]
+x[(y := 1)]  # comment
+x[(y := 1)] = z
+x[1]
+
+
+def lookup(keys, values, key):
+    return values[(i := bisect_left(keys, key))], i
